{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flybrain-research-platform-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-18",
  "workers_dev": true,
  "observability": { "enabled": true },
  "ratelimits": [
    {
      "name": "FLYBRAIN_PUBLIC_LIMITER",
      "namespace_id": "26111702",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "services": [
    {
      "binding": "FLYBRAIN_BROWSER_WORKER",
      "service": "flybrain-browser-staging"
    }
  ]
}